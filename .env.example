# ========================================
# BambooHR Configuration
# ========================================
# Your BambooHR employee ID
# Find this in your BambooHR profile URL or ask your HR admin
BAMBOO_EMPLOYEE_ID=xxxx

# Your BambooHR API key
# Generate at: BambooHR → Your Name → API Keys → Generate new key
BAMBOO_API_KEY=xxxx

# BambooHR subdomain (optional, defaults to "yourcompany")
# BAMBOO_SUBDOMAIN=yourcompany

# ========================================
# Productive.io Configuration
# ========================================
# Your Productive.io API token
# Generate at: Settings → API integrations → Generate new token
PRODUCTIVE_API_TOKEN=xxxx

# Your Productive.io Organization ID
# Found in your Productive URL or API settings
PRODUCTIVE_ORG_ID=xxxx

# Your Productive.io Person ID (your user ID)
# Discover via API: GET /api/v2/people?filter[email]=your@email.com
PRODUCTIVE_PERSON_ID=xxxx

# The Service ID where you log your hours
# Discover via API: GET /api/v2/time_entries with your person_id and check the service relationship
PRODUCTIVE_SERVICE_ID=xxxx
